new file mode 100644
index 0000000..fb40a1d
--- /dev/null
+++ b/server/instaworkUser.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it } from "vitest";
+
+import { resolveInstaworkUser } from "./instaworkUser";
+
+describe("resolveInstaworkUser", () => {
+  it("returns null for null input", () => {
+    expect(resolveInstaworkUser(null)).toBeNull();
+  });
+
+  it("parses JSON:API user id and full_name", () => {
+    expect(
+      resolveInstaworkUser({
+        data: {
+          type: "user",
+          id: "12345678",
+          attributes: {
+            full_name: "Alex Worker",
+            given_name: "Alex",
+            family_name: "Worker",
+          },
+        },
+      }),
+    ).toEqual({ workerId: 12345678, name: "Alex Worker" });
+  });
+
+  it("coerces numeric JSON:API ids", () => {
+    expect(
+      resolveInstaworkUser({
+        data: {
+          id: 42,
+          attributes: { given_name: "Sam", family_name: "Lee" },
+        },
+      }),
+    ).toEqual({ workerId: 42, name: "Sam Lee" });
+  });
+
+  it("builds name from given_name and family_name when full_name is absent", () => {
+    expect(
+      resolveInstaworkUser({
+        data: {
+          id: "99",
+          attributes: { given_name: "Jamie", family_name: "Nguyen" },
+        },
+      }),
+    ).toEqual({ workerId: 99, name: "Jamie Nguyen" });
+  });
+
+  it("accepts flat local-dev shapes with top-level id", () => {
+    expect(
+      resolveInstaworkUser({
+        id: 7,
+        first_name: "Pat",
+        last_name: "Kim",
+      }),
+    ).toEqual({ workerId: 7, name: "Pat Kim" });
+  });
+
+  it("falls back to worker_id then pk", () => {
+    expect(resolveInstaworkUser({ worker_id: 11, name: "Taylor" })).toEqual({
+      workerId: 11,
+      name: "Taylor",
+    });
+    expect(resolveInstaworkUser({ pk: 12, name: "Jordan" })).toEqual({
+      workerId: 12,
+      name: "Jordan",
+    });
+  });
+
+  it("returns null when no usable worker id is present", () => {
+    expect(resolveInstaworkUser({ data: { type: "user", attributes: {} } })).toBeNull();
+    expect(resolveInstaworkUser({ data: { id: "not-a-number", attributes: {} } })).toBeNull();
+  });
+
+  it("returns null name when no name fields are present", () => {
+    expect(resolveInstaworkUser({ data: { id: "5", attributes: {} } })).toEqual({
+      workerId: 5,
+      name: null,
+    });
+  });
+});
diff --git a/server/instaworkUser.ts b/server/instaworkUser.ts
new file mode 100644
index 0000000..0b1e1c8
--- /dev/null
+++ b/server/instaworkUser.ts
@@ -0,0 +1,26 @@
+export type ResolvedInstaworkUser = {
+  workerId: number;
+  name: string | null;
+};
+
+/** Instawork /api/users/me/ returns JSON:API; accept flat shapes for local dev. */
+export function resolveInstaworkUser(
+  userData: Record<string, unknown> | null,
+): ResolvedInstaworkUser | null {
+  if (!userData) return null;
+  const data = userData.data as
+    | { id?: string | number; attributes?: Record<string, unknown> }
+    | undefined;
+  const attrs = (data?.attributes ?? userData) as Record<string, unknown>;
+  const rawId = data?.id ?? userData.id ?? userData.worker_id ?? userData.pk;
+  const workerId = Number(rawId);
+  if (!Number.isFinite(workerId)) return null;
+  const name =
+    (typeof attrs.full_name === "string" && attrs.full_name) ||
+    [attrs.given_name, attrs.family_name].filter((part) => typeof part === "string" && part).join(" ") ||
+    [attrs.first_name ?? attrs.name, attrs.last_name]
+      .filter((part) => typeof part === "string" && part)
+      .join(" ") ||
+    null;
+  return { workerId, name: name || null };
+}
